---
/**
 * Der markierte Bescheid — das Signaturelement dieser Seite
 * (STATE.md → Design-Richtung, mit 5.1 entschieden).
 *
 * Ein Ausschnitt aus einem Behördenschreiben, in der Schrift eines
 * Behördenschreibens, mit farbig hervorgehobenen Stellen und einer Erklärung
 * daneben. Das ist der Grund, warum es diese Seite gibt: Wer einen Bescheid
 * nicht versteht, scheitert nicht an der Rechtslage, sondern an einem Satz
 * wie „Der Bedarf wird nach § 20 Abs. 2 SGB II berücksichtigt".
 *
 * **Der Text ist ein Muster, kein echter Bescheid.** Das steht sichtbar dabei
 * und nicht nur im Quelltext: Ein nachgebautes Behördenschreiben, das man für
 * echt halten könnte, wäre auf einer Seite über Behördenpost das falsche
 * Signal — und Beträge aus einem erfundenen Bescheid würden zwangsläufig als
 * Aussage über echte Bescheide gelesen.
 *
 * Die Markierung trägt Bedeutung, deshalb erzwingt das Print-CSS ihre Fläche
 * (`.hervorhebung`, global.css). Sie ist außerdem nie das einzige Merkmal:
 * jede markierte Stelle hat eine nummerierte Erklärung darunter, damit sie
 * auch vorgelesen und in Graustufen funktioniert.
 */
export interface Markierung {
  /** Der wörtliche Ausschnitt, der hervorgehoben wird. */
  stelle: string;
  /** Was dort tatsächlich steht, in normaler Sprache. */
  erklaerung: string;
  /** Fundstelle, wenn die Stelle eine Vorschrift nennt. */
  fundstelle?: string;
}

interface Props {
  /** Überschriftzeile des Ausschnitts, z. B. „Aus einem Bewilligungsbescheid". */
  titel: string;
  /** Die Absätze des Musterschreibens. */
  absaetze: string[];
  /** Die erklärten Stellen, in der Reihenfolge ihres Auftretens. */
  markierungen: Markierung[];
}

const { titel, absaetze, markierungen } = Astro.props;

/**
 * Setzt die Markierungen in den Text. Bewusst eine simple Ersetzung auf
 * wörtlichen Ausschnitten: Wer eine Stelle erklären will, muss sie exakt so
 * hinschreiben, wie sie im Absatz steht — sonst erscheint sie unmarkiert, und
 * das fällt beim ersten Blick auf die Seite auf. Eine Fuzzy-Suche würde
 * stattdessen die falsche Stelle markieren, und das fiele niemandem auf.
 */
function markiere(absatz: string): string {
  let html = absatz
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  markierungen.forEach((m, i) => {
    const roh = m.stelle.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    html = html.replace(
      roh,
      `<mark class="hervorhebung bg-hervorhebung px-0.5 text-ink">${roh}<sup class="ml-0.5 font-sans text-[0.7em] font-semibold">${i + 1}</sup></mark>`,
    );
  });
  return html;
}
---

<figure class="bescheidauszug">
  <figcaption class="flex flex-wrap items-baseline gap-x-3 text-sm text-ink-mute">
    <span class="font-semibold text-ink">{titel}</span>
    <span>Musterschreiben — kein echter Bescheid</span>
  </figcaption>

  <div class="mt-2 border border-rule bg-paper p-5 sm:p-7">
    {
      absaetze.map((absatz) => (
        <p
          class="mt-3 font-[Times_New_Roman,serif] text-[16px] leading-relaxed text-ink first:mt-0"
          set:html={markiere(absatz)}
        />
      ))
    }
  </div>

  <ol class="mt-4 flex flex-col divide-y divide-rule border-y border-rule">
    {
      markierungen.map((m, i) => (
        <li class="flex gap-3 py-3">
          <span
            class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-hervorhebung text-[13px] font-semibold text-ink"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <div class="min-w-0">
            <p class="text-[15px] text-ink">
              <span class="sr-only">Markierung {i + 1}: </span>
              {m.erklaerung}
            </p>
            {m.fundstelle && (
              <p class="mt-1 text-[14px] text-ink-mute">{m.fundstelle}</p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</figure>
