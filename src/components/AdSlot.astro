---
/**
 * Ad container. Empty until this site's AdSense review passes and `ads.ts`
 * (queue task 4.8) fills it with the `<ins>` tag. The class must stay
 * `.ad-slot` — print CSS in global.css hides it by that selector.
 *
 * `data-dev` is what carries the dashed placeholder outline (global.css:
 * `.ad-slot[data-dev]:empty`), and it is only emitted in dev: in production
 * the slot is empty for months until AdSense is through, and a dashed box
 * on every page is clutter a visitor sees and we do not (root CLAUDE.md →
 * Advertising slots).
 *
 * No `aria-label` while the slot is empty — an empty div with a label is
 * announced by screen readers as a region containing nothing. The label
 * comes back with the real `<ins>` in 4.8.
 */
interface Props {
  label?: string;
}

const { label } = Astro.props;
const isDev = import.meta.env.DEV;
---

<div class="ad-slot" data-dev={isDev ? '' : undefined} aria-label={label}></div>
