---
export type IconName =
  | 'bescheid'
  | 'frist'
  | 'markierung'
  | 'pruefen'
  | 'quelle'
  | 'hinweis'
  | 'wohnen'
  | 'ausbildung'
  | 'rente';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg class={className} aria-hidden="true"><use href={`#i-${name}`}></use></svg>
