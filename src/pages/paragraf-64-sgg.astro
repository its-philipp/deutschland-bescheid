---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Icon from '../components/Icon.astro';
import Quellen from '../components/Quellen.astro';
import daten from '../data/sources/paragraf-64-sgg.json';
import { isoLang } from '../lib/format';
import { berechneFrist } from '../lib/frist';

/**
 * § 64 SGG, Absatz für Absatz (2026-11-15).
 *
 * Aus den Suchdaten: „64 sgg" und „§ 64 sgg" hatten in drei Monaten 26
 * Impressionen auf Position 10 bis 11 — auf der Fristenseite, die den
 * Paragrafen anwendet, aber nicht erklärt. Wer die Norm sucht, will den
 * Wortlaut und wissen, was er heißt.
 *
 * **Was diese Seite von einer Gesetzessammlung unterscheidet:** die vier
 * durchgerechneten Fälle. Sie werden beim Bauen von `berechneFrist` gerechnet —
 * derselben Funktion, die `check:fristen` gegen die Grenzfälle der Erhebung
 * prüft. Im Datensatz steht nur der Tag der Aufgabe zur Post; jedes weitere
 * Datum entsteht hier. Ein Beispiel kann damit nicht vom Rechner abweichen.
 *
 * Die Beispiele sind so gewählt, dass ihr Ende auf keinen bundeseinheitlichen
 * Feiertag fällt — der Rechner kennt nur Sonnabend und Sonntag, und ein
 * Beispiel, das an einem Feiertag endet, wäre falsch gerechnet.
 */
const beispiele = daten.beispiele.map((b) => ({ ...b, ergebnis: berechneFrist({ aufgabeZurPost: b.aufgabe_zur_post }) }));
---

<BaseLayout
  title="§ 64 SGG: Fristbeginn und Fristende, mit Rechenbeispielen"
  description="§ 64 SGG im Wortlaut und Absatz für Absatz erklärt: wann eine Frist beginnt, wann die Monatsfrist endet und was am Wochenende gilt — mit vier Beispielen."
  path="/paragraf-64-sgg/"
>
  <nav class="text-[14px] text-ink-mute" aria-label="Sie sind hier">
    <a href="/" class="underline underline-offset-2">Startseite</a> ·{' '}
    <a href="/widerspruchsfrist/" class="underline underline-offset-2">Widerspruchsfrist</a> · § 64 SGG
  </nav>

  <h1 class="mt-2 font-display text-[clamp(1.9rem,5vw,2.75rem)] leading-tight text-ink">
    § 64 SGG: wie eine Frist im Sozialrecht gerechnet wird
  </h1>
  <p class="mt-4 max-w-prose text-ink-soft">
    § 64 des Sozialgerichtsgesetzes hat drei Absätze und beantwortet drei
    Fragen: Ab wann läuft eine Frist, an welchem Tag endet sie, und was
    geschieht, wenn dieser Tag ein Sonnabend, Sonntag oder Feiertag ist. Wie
    lang die Frist ist, steht dort nicht — das regelt die Vorschrift, die die
    Frist anordnet.
  </p>

  <section class="mt-12">
    <h2 class="font-display text-2xl text-ink">Der Wortlaut, Absatz für Absatz</h2>
    <div class="mt-6 flex flex-col gap-8">
      {
        daten.absaetze.map((a) => (
          <article class="border-t-4 border-marker bg-paper p-5 sm:p-6">
            <h3 class="font-display text-xl text-ink">
              Absatz {a.nr}: {a.thema}
            </h3>
            <blockquote class="mt-3 border-l-4 border-marker bg-marker-tint px-4 py-3 text-ink">
              „{a.wortlaut}"
              <span class="mt-1 block text-[14px] text-ink-soft">§ 64 Abs. {a.nr} SGG</span>
            </blockquote>
            <ul class="mt-4 flex flex-col gap-2">
              {a.erklaerung.map((e) => (
                <li class="flex gap-2.5 text-[15px] text-ink">
                  <Icon name="pruefen" class="mt-1 h-4 w-4 shrink-0 text-marker" />
                  <span>{e}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <div class="mt-10">
    <AdSlot />
  </div>

  <section class="mt-14">
    <h2 class="font-display text-2xl text-ink">Vier Fälle, durchgerechnet</h2>
    <p class="mt-3 max-w-prose text-ink-soft">
      Gerechnet ist jeweils die Monatsfrist für den Widerspruch gegen einen
      Bescheid, der mit einfachem Brief verschickt wurde. Landesfeiertage sind
      nicht berücksichtigt.
    </p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        beispiele.map((b) => (
          <article class="border-t-4 border-marker bg-paper p-5">
            <h3 class="flex items-center gap-2 font-display text-lg text-ink">
              <Icon name="frist" class="h-5 w-5 shrink-0 text-marker" />
              {b.titel}
            </h3>
            <dl class="mt-3 flex flex-col divide-y divide-rule border-y border-rule text-[15px]">
              <div class="flex items-baseline justify-between gap-4 py-2">
                <dt class="text-ink-soft">zur Post gegeben</dt>
                <dd class="tabular-nums text-ink">{isoLang(b.aufgabe_zur_post)}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 py-2">
                <dt class="text-ink-soft">bekannt gegeben</dt>
                <dd class="tabular-nums text-ink">{isoLang(b.ergebnis.bekanntgabe)}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 py-2">
                <dt class="text-ink-soft">Frist läuft ab</dt>
                <dd class="tabular-nums text-ink">{isoLang(b.ergebnis.fristbeginn)}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4 py-2">
                <dt class="text-ink-soft">letzter Tag</dt>
                <dd class="font-semibold tabular-nums text-ink">
                  {b.ergebnis.fristendeWochentag}, {isoLang(b.ergebnis.fristende)}
                </dd>
              </div>
            </dl>
            <p class="mt-3 text-[15px] text-ink-soft">{b.zeigt}</p>
          </article>
        ))
      }
    </div>
    <p class="mt-5 max-w-prose text-ink-soft">
      Für Ihr eigenes Datum rechnet der{' '}
      <a href="/widerspruchsfrist/" class="text-ink underline underline-offset-2">
        Rechner auf der Seite zur Widerspruchsfrist
      </a>
      {' '}nach denselben Regeln.
    </p>
  </section>

  <section class="mt-14">
    <h2 class="font-display text-2xl text-ink">Für welche Fristen § 64 gilt</h2>
    <ul class="mt-5 flex flex-col divide-y divide-rule border-y border-rule">
      {
        daten.gilt_fuer.map((f) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
            <span class="min-w-0 flex-1 text-ink">
              {f.frist}
              <span class="block text-[14px] text-ink-mute">{f.norm}</span>
            </span>
            <span class="text-[15px] text-ink-soft sm:max-w-[45%] sm:text-right">{f.dauer}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14 max-w-prose">
    <h2 class="font-display text-2xl text-ink">Was § 64 nicht regelt</h2>
    <dl class="mt-5 flex flex-col divide-y divide-rule border-y border-rule">
      {
        daten.regelt_nicht.map((r) => (
          <div class="py-3">
            <dt class="font-medium text-ink">{r.frage}</dt>
            <dd class="mt-1 text-[15px] text-ink-soft">{r.antwort}</dd>
            <dd class="mt-1 text-[14px] text-ink-mute">{r.norm}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <Quellen
    quellen={daten._meta.sources}
    erhobenAm={daten._meta.retrieved}
    einleitung="Der Wortlaut und alle Angaben stammen aus dem Volltext der Vorschriften, gelesen am"
  />

  <Disclaimer />

  <div class="mt-10">
    <AdSlot />
  </div>
</BaseLayout>
