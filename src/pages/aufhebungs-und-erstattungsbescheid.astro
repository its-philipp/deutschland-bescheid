---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Bescheidauszug from '../components/Bescheidauszug.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Fristkette from '../components/Fristkette.astro';
import Icon from '../components/Icon.astro';
import Pruefpunkte from '../components/Pruefpunkte.astro';
import Quellen from '../components/Quellen.astro';
import { euro } from '../lib/format';
import { jahrAus } from '../lib/jahr';
import {
  AUFRECHNUNG,
  AUFRECHNUNG_GRENZEN,
  AUFRECHNUNG_IN_EURO,
  AUFRECHNUNG_PROZENTE,
  AUFRECHNUNG_SAETZE,
  AUFSCHIEBENDE_WIRKUNG,
  BAGATELLGRENZE,
  BEHOERDENFRISTEN,
  ERHOBEN_AM,
  FRIST,
  MUSTERAUSZUG,
  PRUEFPUNKTE,
  QUELLEN,
  RDG_GRENZE,
  UEBERBLICK,
} from '../data/aufhebungErstattung';

/**
 * Die Erklärseite zum Aufhebungs- und Erstattungsbescheid des Jobcenters
 * (2026-11-15) — der Bescheid, mit dem Geld zurückgefordert wird.
 *
 * **Die RDG-Linie ist hier noch dünner als auf den Bewilligungsseiten**, weil
 * die Leser Geld schulden sollen und eine Antwort auf „muss ich zahlen?"
 * suchen. Diese Seite gibt sie nicht. Sie sagt, welche Vorschrift was
 * voraussetzt, welche Fristen die Behörde hat und wie hoch die Aufrechnung
 * nach dem Gesetz ist — nie, ob ein Bescheid diese Voraussetzungen erfüllt.
 *
 * Zwei Stellen, an denen die Seite bewusst nur den Wortlaut wiedergibt:
 * aufschiebende Wirkung bei der Erstattung (§ 39 SGB II nennt sie nicht) und
 * die Verteilung der Erstattung auf die Mitglieder der Bedarfsgemeinschaft
 * (im Gesetzestext steht dazu nichts). Wer dort „klarer" formuliert, erfindet
 * Recht.
 */
---

<BaseLayout
  title={`Aufhebungs- und Erstattungsbescheid vom Jobcenter verstehen ${jahrAus(ERHOBEN_AM)}`}
  description="Das Jobcenter fordert Geld zurück: was §§ 45, 48 SGB X voraussetzen, welche Fristen die Behörde hat, die 50-Euro-Grenze und 10 oder 30 Prozent Aufrechnung."
  path="/aufhebungs-und-erstattungsbescheid/"
>
  <nav class="text-[14px] text-ink-mute" aria-label="Sie sind hier">
    <a href="/" class="underline underline-offset-2">Startseite</a> · Aufhebungs- und
    Erstattungsbescheid
  </nav>

  <h1 class="mt-2 font-display text-[clamp(1.9rem,5vw,2.75rem)] leading-tight text-ink">
    Wenn das Jobcenter Geld zurückfordert: der Aufhebungs- und Erstattungsbescheid
  </h1>
  <p class="mt-4 max-w-prose text-ink-soft">{UEBERBLICK.was_ist_das}</p>
  <p class="mt-3 max-w-prose text-ink-soft">
    <strong class="text-ink">Die wichtigste Zeile ist die mit dem Paragrafen.</strong> Ob
    sich der Bescheid auf § 45 oder § 48 SGB X oder auf § 41a SGB II stützt, entscheidet
    darüber, was die Behörde nachweisen muss, wie lange sie Zeit hatte — und ob sie
    monatlich 10 oder 30 Prozent des Regelbedarfs einbehalten darf.
  </p>

  <div class="mt-10">
    <Bescheidauszug
      titel="Aus einem Aufhebungs- und Erstattungsbescheid"
      absaetze={MUSTERAUSZUG.absaetze}
      markierungen={MUSTERAUSZUG.markierungen}
    />
  </div>

  <div class="mt-10">
    <AdSlot />
  </div>

  <section class="mt-14">
    <h2 class="font-display text-2xl text-ink">
      Auf welche Vorschrift sich die Aufhebung stützen kann
    </h2>
    <p class="mt-3 max-w-prose text-ink-soft">
      Das Gesetz kennt mehrere Wege, eine Bewilligung zu beseitigen. Sie
      unterscheiden sich darin, ob die Bewilligung von Anfang an falsch war oder
      erst später falsch wurde — und darin, ob es auf Ihr Verschulden ankommt.
    </p>

    <div class="mt-6 flex flex-col gap-6">
      {
        UEBERBLICK.rechtsgrundlagen.map((r) => (
          <article class="border-t-4 border-marker bg-paper p-5 sm:p-6">
            <h3 class="font-display text-xl text-ink">{r.fall}</h3>
            <p class="mt-1 text-[14px] text-ink-mute">
              {r.norm} · wirkt für: {r.wirkung_fuer}
            </p>
            <ul class="mt-4 flex flex-col gap-2">
              {r.voraussetzungen.map((v) => (
                <li class="flex gap-2.5 text-[15px] text-ink">
                  <Icon name="pruefen" class="mt-1 h-4 w-4 shrink-0 text-marker" />
                  <span>{v}</span>
                </li>
              ))}
            </ul>
            {r.hinweis && <p class="mt-4 text-[15px] text-ink-mute">{r.hinweis}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-14">
    <h2 class="font-display text-2xl text-ink">Fristen, die das Jobcenter einhalten muss</h2>
    <p class="mt-3 max-w-prose text-ink-soft">
      Nicht nur Sie haben eine Frist. Auch die Behörde kann eine Bewilligung
      nicht unbegrenzt lange rückwirkend beseitigen. Diese Fristen stehen in
      keinem Bescheid — man muss sie gegen die Daten im Bescheid halten.
    </p>
    <ol class="mt-5 flex flex-col divide-y divide-rule border-y border-rule">
      {
        BEHOERDENFRISTEN.map((f) => (
          <li class="flex gap-3 py-4">
            <Icon name="frist" class="mt-1 h-5 w-5 shrink-0 text-marker" />
            <div class="min-w-0">
              <p class="font-medium text-ink">{f.frist}</p>
              <p class="mt-1 text-[14px] text-ink-mute">{f.norm}</p>
              <p class="mt-2 max-w-prose text-[15px] text-ink-soft">{f.erlaeuterung}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-14 max-w-prose">
    <h2 class="font-display text-2xl text-ink">
      Die {BAGATELLGRENZE.betrag_eur}-Euro-Grenze
    </h2>
    <p class="mt-4 border-l-4 border-marker bg-marker-tint px-4 py-3 text-ink">
      {BAGATELLGRENZE.wortlaut_kurz}
      <span class="mt-1 block text-[14px] text-ink-soft">{BAGATELLGRENZE.norm}</span>
    </p>
    <p class="mt-3 text-[15px] text-ink-soft">{BAGATELLGRENZE.hinweis}</p>
  </section>

  <section class="mt-14">
    <h2 class="font-display text-2xl text-ink">
      Aufrechnung: {AUFRECHNUNG_PROZENTE.join(' oder ')} Prozent — je nach Rechtsgrundlage
    </h2>
    <p class="mt-3 max-w-prose text-ink-soft">
      Wer weiter Grundsicherungsgeld bezieht, zahlt die Erstattung meist nicht
      in einer Summe: Das Jobcenter behält monatlich einen Teil der laufenden
      Leistung ein. Wie viel, legt das Gesetz fest — und es hängt an der
      Vorschrift, auf der die Erstattung beruht.
    </p>

    <ul class="mt-5 flex flex-col divide-y divide-rule border-y border-rule">
      {
        AUFRECHNUNG_SAETZE.map((s) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
            <span class="min-w-0 flex-1 text-[15px] text-ink-soft">
              {s.fall}
              <span class="block text-[14px] text-ink-mute">{s.norm}</span>
            </span>
            <span class="font-display text-xl font-semibold text-ink">
              {s.prozent_des_regelbedarfs} %
            </span>
          </li>
        ))
      }
    </ul>

    <h3 class="mt-8 font-display text-xl text-ink">Was das in Euro im Monat bedeutet</h3>
    <p class="mt-2 max-w-prose text-[15px] text-ink-soft">
      Gerechnet wird vom Regelbedarf der Person, gegen deren Anspruch
      aufgerechnet wird — nicht von der ausgezahlten Summe und nicht von den
      Unterkunftskosten.
    </p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[26rem] border-collapse text-[15px]">
        <caption class="sr-only">
          Monatlicher Aufrechnungsbetrag je Regelbedarfsstufe bei {AUFRECHNUNG_PROZENTE.join(' und ')}
          Prozent
        </caption>
        <thead>
          <tr class="border-y border-rule text-left text-[14px] text-ink-mute">
            <th scope="col" class="py-2 pr-3 font-normal">Regelbedarfsstufe</th>
            <th scope="col" class="py-2 pr-3 text-right font-normal">Regelbedarf</th>
            {
              AUFRECHNUNG_PROZENTE.map((p) => (
                <th scope="col" class="py-2 pr-3 text-right font-normal">
                  {p} %
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            AUFRECHNUNG_IN_EURO.map((z) => (
              <tr class="border-b border-rule/60">
                <th scope="row" class="py-2 pr-3 text-left font-semibold text-ink">
                  Stufe {z.nummer}
                </th>
                <td class="py-2 pr-3 text-right tabular-nums text-ink-soft">{euro(z.regelbedarf)}</td>
                {z.betraege.map((b) => (
                  <td class="py-2 pr-3 text-right tabular-nums text-ink">{euro(b.euro)}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-[14px] text-ink-mute">
      {AUFRECHNUNG.norm} · berechnet aus den{' '}
      <a href="/regelbedarf/" class="underline underline-offset-2">Regelbedarfsstufen</a>
    </p>

    <h3 class="mt-8 font-display text-xl text-ink">Grenzen der Aufrechnung</h3>
    <ul class="mt-4 flex max-w-prose flex-col gap-3">
      {
        AUFRECHNUNG_GRENZEN.map((g) => (
          <li class="flex gap-2.5 text-[15px] text-ink">
            <Icon name="hinweis" class="mt-0.5 h-5 w-5 shrink-0 text-marker" />
            <span>
              {g.fall}
              <span class="block text-[14px] text-ink-mute">{g.norm}</span>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 max-w-prose text-[15px] text-ink-soft">{AUFRECHNUNG.hoechstdauer}</p>
    <p class="mt-3 max-w-prose text-[15px] text-ink-soft">{AUFRECHNUNG.hinweis}</p>
  </section>

  <Pruefpunkte punkte={PRUEFPUNKTE} />

  <section class="mt-14 max-w-prose">
    <h2 class="font-display text-2xl text-ink">
      Was der Widerspruch aufschiebt — und was das Gesetz dazu offen lässt
    </h2>
    <p class="mt-3 flex gap-2.5 text-ink-soft">
      <Icon name="frist" class="mt-1 h-5 w-5 shrink-0 text-marker" />
      <span>
        <strong class="text-ink">Aufhebung:</strong> {AUFSCHIEBENDE_WIRKUNG.aufhebung.aussage}
        <span class="block text-[14px] text-ink-mute">{AUFSCHIEBENDE_WIRKUNG.aufhebung.norm}</span>
      </span>
    </p>
    <p class="mt-4 flex gap-2.5 text-ink-soft">
      <Icon name="hinweis" class="mt-1 h-5 w-5 shrink-0 text-marker" />
      <span>
        <strong class="text-ink">Erstattung:</strong> {AUFSCHIEBENDE_WIRKUNG.erstattung.aussage}
        <span class="block text-[14px] text-ink-mute">{AUFSCHIEBENDE_WIRKUNG.erstattung.norm}</span>
      </span>
    </p>
    <p class="mt-4 text-[15px] text-ink-soft">{AUFSCHIEBENDE_WIRKUNG.hinweis}</p>
  </section>

  <Fristkette frist={FRIST} />

  <p class="mt-5 max-w-prose text-[15px] text-ink-mute">{RDG_GRENZE}</p>

  <Quellen quellen={QUELLEN} erhobenAm={ERHOBEN_AM} />

  <Disclaimer />

  <div class="mt-10">
    <AdSlot />
  </div>
</BaseLayout>
