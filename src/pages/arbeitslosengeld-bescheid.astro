---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Bescheidauszug from '../components/Bescheidauszug.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Fristkette from '../components/Fristkette.astro';
import Icon from '../components/Icon.astro';
import Pruefpunkte from '../components/Pruefpunkte.astro';
import Quellen from '../components/Quellen.astro';
import { euro } from '../lib/format';
import { jahrAus } from '../lib/jahr';
import {
  ABZUEGE,
  ANSPRUCHSDAUER,
  ERHOBEN_AM,
  FRIST,
  LEISTUNGSSATZ,
  MELDEFRISTEN,
  MUSTERAUSZUG,
  NEBENEINKOMMEN,
  PRUEFPUNKTE,
  QUELLEN,
  RDG_GRENZE,
  RECHENWEG,
  RUHEN,
  SPERRZEIT,
} from '../data/arbeitslosengeld';

/**
 * Die Erklärseite zum Bewilligungsbescheid über Arbeitslosengeld (2026-11-15).
 *
 * **Sie rechnet nicht.** Der Bescheid nennt ein tägliches Bemessungsentgelt
 * und einen täglichen Leistungsbetrag; dazwischen liegt die Lohnsteuer nach
 * dem Programmablaufplan des Finanzministeriums, die hier nicht abgebildet ist.
 * Die Seite erklärt deshalb jeden Schritt und nennt die Stellen, an denen bei
 * diesem Bescheidtyp Fehler vorkommen — einen Betrag nennt sie nicht.
 *
 * **Keine Steuerberatung:** Zur Lohnsteuerklasse steht nur, was § 153 SGB III
 * regelt (Stichtag, Wechsel). Keine Empfehlung, welche Klasse günstiger wäre.
 */
const r = RECHENWEG.rechengroessen_2026;
---

<BaseLayout
  title={`Arbeitslosengeld-Bescheid verstehen: Betrag, Dauer ${jahrAus(ERHOBEN_AM)}`}
  description="Bemessungsentgelt, Leistungsentgelt, Leistungssatz: wie der Arbeitslosengeld-Bescheid rechnet, wie lange gezahlt wird und was Sperrzeit und Ruhen ändern."
  path="/arbeitslosengeld-bescheid/"
>
  <nav class="text-[14px] text-ink-mute" aria-label="Sie sind hier">
    <a href="/" class="underline underline-offset-2">Startseite</a> · Arbeitslosengeld-Bescheid
  </nav>

  <h1 class="mt-2 font-display text-[clamp(1.9rem,5vw,2.75rem)] leading-tight text-ink">
    Der Arbeitslosengeld-Bescheid: ein Tagesbetrag und eine Zahl von Tagen
  </h1>
  <p class="mt-4 max-w-prose text-ink-soft">
    Ein Bewilligungsbescheid der Agentur für Arbeit beantwortet zwei Fragen:
    wie viel am Tag und für wie viele Tage. Hinter der ersten steht eine
    Rechnung in vier Schritten, hinter der zweiten eine Tabelle im Gesetz —
    und beide können durch Sperrzeit oder Ruhen verändert sein, oft in einem
    eigenen Bescheid mit eigener Frist.
  </p>

  <div class="mt-10">
    <Bescheidauszug
      titel="Aus einem Bewilligungsbescheid über Arbeitslosengeld"
      absaetze={MUSTERAUSZUG.absaetze}
      markierungen={MUSTERAUSZUG.markierungen}
    />
    <p class="mt-3 max-w-prose text-[14px] text-ink-mute">{MUSTERAUSZUG.hinweis}</p>
  </div>

  <div class="mt-10">
    <AdSlot />
  </div>

  <section class="mt-14">
    <h2 class="font-display text-2xl text-ink">Der Rechenweg: vom Bruttolohn zum Tagesbetrag</h2>
    <ol class="mt-5 flex flex-col divide-y divide-rule border-y border-rule">
      {
        RECHENWEG.schritte.map((s) => (
          <li class="flex gap-3 py-4">
            <span class="font-display text-lg font-semibold text-marker">{s.nr}</span>
            <div class="min-w-0">
              <p class="font-medium text-ink">{s.name}</p>
              <p class="mt-1 text-[14px] text-ink-mute">{s.norm}</p>
              <p class="mt-2 max-w-prose text-[15px] text-ink-soft">{s.erklaerung}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <article class="border-t-4 border-marker bg-paper p-5">
        <h3 class="font-display text-xl text-ink">Leistungssatz</h3>
        <p class="mt-1 text-[14px] text-ink-mute">{LEISTUNGSSATZ.norm}</p>
        <ul class="mt-3 flex flex-col divide-y divide-rule border-y border-rule">
          {
            LEISTUNGSSATZ.saetze.map((s) => (
              <li class="flex items-baseline justify-between gap-4 py-3">
                <span class="min-w-0 flex-1 text-[15px] text-ink-soft">{s.fall}</span>
                <span class="font-display text-xl font-semibold text-ink">{s.prozent} %</span>
              </li>
            ))
          }
        </ul>
      </article>
      <article class="border-t-4 border-marker bg-paper p-5">
        <h3 class="font-display text-xl text-ink">Rechengrößen {jahrAus(ERHOBEN_AM)}</h3>
        <p class="mt-1 text-[14px] text-ink-mute">{r.norm}</p>
        <ul class="mt-3 flex flex-col divide-y divide-rule border-y border-rule text-[15px]">
          <li class="flex items-baseline justify-between gap-4 py-3">
            <span class="text-ink-soft">Bezugsgröße im Monat</span>
            <span class="font-semibold tabular-nums text-ink">{euro(r.bezugsgroesse_monatlich_eur)}</span>
          </li>
          <li class="flex items-baseline justify-between gap-4 py-3">
            <span class="text-ink-soft">Beitragsbemessungsgrenze der allgemeinen Rentenversicherung im Monat</span>
            <span class="font-semibold tabular-nums text-ink">
              {euro(r.beitragsbemessungsgrenze_allgemeine_rv_monatlich_eur)}
            </span>
          </li>
        </ul>
        <p class="mt-3 text-[14px] text-ink-mute">{r.fundstelle}. {r.gilt_fuer}</p>
      </article>
    </div>

    <h3 class="mt-8 font-display text-xl text-ink">Was vom Bemessungsentgelt abgezogen wird</h3>
    <ul class="mt-4 flex flex-col divide-y divide-rule border-y border-rule">
      {
        ABZUEGE.posten.map((p) => (
          <li class="py-3">
            <p class="font-medium text-ink">{p.abzug}</p>
            <p class="mt-1 max-w-prose text-[15px] text-ink-soft">{p.hoehe_oder_regel}</p>
            <p class="mt-1 text-[14px] text-ink-mute">{p.norm}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 max-w-prose text-[15px] text-ink-soft">{RECHENWEG.hinweis}</p>
  </section>

  <section class="mt-14">
    <h2 class="font-display text-2xl text-ink">Wie lange Arbeitslosengeld gezahlt wird</h2>
    <p class="mt-3 max-w-prose text-ink-soft">
      Die Dauer hängt an zwei Größen: wie lange Sie versicherungspflichtig
      waren und wie alt Sie sind, wenn der Anspruch entsteht.
    </p>
    <div class="mt-5 overflow-x-auto">
      <table class="w-full min-w-[28rem] border-collapse text-[15px]">
        <caption class="sr-only">
          Anspruchsdauer in Monaten nach Dauer der Versicherungspflicht und Lebensalter
        </caption>
        <thead>
          <tr class="border-y border-rule text-left text-[14px] text-ink-mute">
            <th scope="col" class="py-2 pr-3 font-normal">Versicherungspflicht mindestens</th>
            <th scope="col" class="py-2 pr-3 font-normal">Vollendetes Lebensjahr</th>
            <th scope="col" class="py-2 text-right font-normal">Anspruchsdauer</th>
          </tr>
        </thead>
        <tbody>
          {
            ANSPRUCHSDAUER.zeilen.map((z) => (
              <tr class="border-b border-rule/60">
                <td class="py-2 pr-3 tabular-nums text-ink">{z.versicherungspflicht_monate} Monate</td>
                <td class="py-2 pr-3 text-ink-soft">
                  {z.lebensalter_ab === null ? 'jedes Alter' : `ab dem ${z.lebensalter_ab}.`}
                </td>
                <td class="py-2 text-right font-semibold tabular-nums text-ink">
                  {z.dauer_monate} Monate
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-[14px] text-ink-mute">{ANSPRUCHSDAUER.norm}</p>
    <p class="mt-3 max-w-prose text-[15px] text-ink-soft">{ANSPRUCHSDAUER.hinweis}</p>

    <h3 class="mt-8 font-display text-xl text-ink">
      Sonderfall: kurze Anwartschaft nach {ANSPRUCHSDAUER.kurze_anwartschaft.anwartschaft_monate} Monaten
    </h3>
    <ul class="mt-4 flex max-w-prose flex-col gap-2">
      {
        ANSPRUCHSDAUER.kurze_anwartschaft.voraussetzungen.map((v) => (
          <li class="flex gap-2.5 text-[15px] text-ink">
            <Icon name="pruefen" class="mt-1 h-4 w-4 shrink-0 text-marker" />
            <span>{v}</span>
          </li>
        ))
      }
    </ul>
    <ul class="mt-4 flex max-w-prose flex-col divide-y divide-rule border-y border-rule text-[15px]">
      {
        ANSPRUCHSDAUER.kurze_anwartschaft.zeilen.map((z) => (
          <li class="flex items-baseline justify-between gap-4 py-2">
            <span class="text-ink-soft">nach {z.versicherungspflicht_monate} Monaten Versicherungspflicht</span>
            <span class="font-semibold tabular-nums text-ink">{z.dauer_monate} Monate</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 max-w-prose text-[15px] text-ink-soft">
      {ANSPRUCHSDAUER.kurze_anwartschaft.hinweis}
      <span class="block text-[14px] text-ink-mute">{ANSPRUCHSDAUER.kurze_anwartschaft.norm}</span>
    </p>
  </section>

  <section class="mt-14">
    <h2 class="font-display text-2xl text-ink">Sperrzeit: Gründe, Dauer und was sie kostet</h2>
    <p class="mt-3 max-w-prose text-ink-soft">{SPERRZEIT.allgemein}</p>
    <ul class="mt-5 flex flex-col divide-y divide-rule border-y border-rule">
      {
        SPERRZEIT.tatbestaende.map((t) => (
          <li class="py-3">
            <p class="max-w-prose text-ink">{t.grund}</p>
            <p class="mt-1 flex max-w-prose gap-2 text-[15px] font-medium text-ink">
              <Icon name="frist" class="mt-0.5 h-5 w-5 shrink-0 text-marker" />
              <span>{t.dauer}</span>
            </p>
            <p class="mt-1 text-[14px] text-ink-mute">{t.norm}</p>
          </li>
        ))
      }
    </ul>
    <h3 class="mt-8 font-display text-xl text-ink">Die Sperrzeit verkürzt auch die Anspruchsdauer</h3>
    <p class="mt-3 max-w-prose text-[15px] text-ink-soft">{SPERRZEIT.folge_fuer_anspruchsdauer}</p>
    <p class="mt-3 flex max-w-prose gap-2.5 text-[15px] text-ink">
      <Icon name="hinweis" class="mt-0.5 h-5 w-5 shrink-0 text-marker" />
      <span>{SPERRZEIT.erloeschen}</span>
    </p>
  </section>

  <section class="mt-14">
    <h2 class="font-display text-2xl text-ink">Wann der Anspruch ruht</h2>
    <p class="mt-3 max-w-prose text-ink-soft">
      Ruhen heißt: Der Anspruch besteht, wird aber für eine Zeit nicht
      ausgezahlt. Anders als bei der Sperrzeit ist das kein Vorwurf.
    </p>
    <div class="mt-5 grid gap-5 sm:grid-cols-2">
      {
        RUHEN.map((x) => (
          <article class="border-t-4 border-marker bg-paper p-5">
            <h3 class="font-display text-lg text-ink">{x.grund}</h3>
            <p class="mt-1 text-[14px] text-ink-mute">{x.norm}</p>
            <p class="mt-2 text-[15px] text-ink-soft">{x.erlaeuterung}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-14 max-w-prose">
    <h2 class="font-display text-2xl text-ink">
      Nebeneinkommen: der Freibetrag von {euro(NEBENEINKOMMEN.freibetrag_eur)}
    </h2>
    <p class="mt-3 text-ink-soft">{NEBENEINKOMMEN.regel}</p>
    <p class="mt-2 text-[14px] text-ink-mute">{NEBENEINKOMMEN.norm}</p>
  </section>

  <section class="mt-14">
    <h2 class="font-display text-2xl text-ink">Meldepflichten und ihre Fristen</h2>
    <ul class="mt-5 flex flex-col divide-y divide-rule border-y border-rule">
      {
        MELDEFRISTEN.map((m) => (
          <li class="py-4">
            <p class="font-medium text-ink">{m.pflicht}</p>
            <p class="mt-1 max-w-prose text-[15px] text-ink-soft">{m.frist}</p>
            <p class="mt-1 max-w-prose text-[15px] text-ink-soft">
              <strong class="text-ink">Folge:</strong> {m.folge}
            </p>
            <p class="mt-1 text-[14px] text-ink-mute">{m.norm}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <Pruefpunkte punkte={PRUEFPUNKTE} />

  <Fristkette frist={FRIST} />

  <p class="mt-5 max-w-prose text-[15px] text-ink-mute">{RDG_GRENZE}</p>

  <Quellen quellen={QUELLEN} erhobenAm={ERHOBEN_AM} />

  <Disclaimer />

  <div class="mt-10">
    <AdSlot />
  </div>
</BaseLayout>
