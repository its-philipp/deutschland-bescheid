---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { ERHOBEN_AM, QUELLEN, REGELBEDARF, STUFEN } from '../data/grundsicherungsgeld';
import { isoToGerman } from '../lib/format';

/**
 * Die Regelbedarfs-Seite (queue task 5.4).
 *
 * **Ihre eigentliche Antwort ist die auf eine Frage, die kein Ratgeber
 * beantwortet:** Warum sind die Beträge 2026 dieselben wie 2025? Nicht aus
 * politischer Entscheidung, sondern weil die Fortschreibung nach unten zeigte
 * und § 28a Abs. 5 SGB XII den Besitzstand wahrt. Wer seinen Bescheid mit dem
 * Vorjahr vergleicht und keinen Unterschied findet, sucht sonst einen Fehler,
 * der keiner ist.
 *
 * **Der Begriffsabschnitt kam am 2026-08-31 dazu, und zwar aus den eigenen
 * Suchdaten.** Die Seite hatte 51 Impressionen — die meiste Nachfrage im
 * Projekt — stand aber auf Position 64. Der Grund lag im Wortschatz: Gesucht
 * wird nach „Regelsatz 2026" und „Bürgergeld", die Seite schrieb ausschliesslich
 * „Regelbedarf" und „Grundsicherungsgeld". Beides ist korrekt (§ 20, § 19
 * SGB II), aber es ist die Sprache des Gesetzes, nicht die der Betroffenen.
 *
 * Der Abschnitt ist deshalb kein Zugeständnis an die Suchmaschine, sondern die
 * Antwort auf eine echte Frage: Wer einen Bescheid bekommt, auf dem
 * „Grundsicherungsgeld" steht, und nach „Bürgergeld" sucht, will wissen, ob das
 * dasselbe ist. Jede Zuordnung darin steht am Primärtext:
 *   - Regelbedarf  = der Bedarf selbst (§ 20 Abs. 1 SGB II, § 27a Abs. 2 SGB XII)
 *   - Regelsatz    = der Betrag, mit dem er in der Sozialhilfe gedeckt wird
 *                    (§ 27a Abs. 3 SGB XII — „monatlicher Pauschalbetrag")
 *   - Grundsicherungsgeld = die Leistung fuer Erwerbsfaehige (§ 19 Abs. 1 SGB II)
 */
const jahr = REGELBEDARF.gueltig_ab.slice(0, 4);
---

<BaseLayout
  title={`Regelbedarf und Regelsatz ${jahr}: die sechs Stufen`}
  description={`Die sechs Regelbedarfsstufen ${jahr} mit Betrag und Zuordnung, der Unterschied zwischen Regelbedarf und Regelsatz — und warum die Beträge nicht gestiegen sind.`}
  path="/regelbedarf/"
>
  <nav class="text-[14px] text-ink-mute" aria-label="Sie sind hier">
    <a href="/" class="underline underline-offset-2">Startseite</a> · Regelbedarf
  </nav>

  <h1 class="mt-2 font-display text-[clamp(1.9rem,5vw,2.75rem)] leading-tight text-ink">
    Regelbedarf {jahr}: die sechs Stufen
  </h1>
  <p class="mt-4 max-w-prose text-ink-soft">
    Der Regelbedarf ist der Posten, mit dem jeder Grundsicherungsgeld-Bescheid
    anfängt. Welche Stufe für Sie gilt, hängt nicht vom Einkommen ab, sondern
    davon, mit wem Sie zusammenleben und wie alt Sie sind.
  </p>

  <div class="mt-8 overflow-x-auto">
    <table class="w-full border-collapse text-[16px]">
      <thead>
        <tr class="border-y border-rule text-left text-[14px] text-ink-mute">
          <th scope="col" class="py-2 pr-3 font-normal">Stufe</th>
          <th scope="col" class="py-2 pr-3 font-normal">Für wen</th>
          <th scope="col" class="py-2 text-right font-normal">Monatlich</th>
        </tr>
      </thead>
      <tbody>
        {
          STUFEN.map((s) => (
            <tr class="border-b border-rule/60">
              <td class="py-3 pr-3 align-top font-semibold text-ink">{s.nummer}</td>
              <td class="py-3 pr-3 align-top text-ink-soft">{s.wer}</td>
              <td class="py-3 text-right align-top font-display text-xl font-semibold text-ink">
                {s.betrag} €
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-3 text-[14px] text-ink-mute">
    {REGELBEDARF.legal_basis} · gültig ab {isoToGerman(REGELBEDARF.gueltig_ab)}
  </p>

  <div class="mt-10">
    <AdSlot />
  </div>

  {
    REGELBEDARF.identisch_mit_2025 && (
      <section class="mt-14 max-w-prose">
        <h2 class="font-display text-2xl text-ink">
          Warum die Beträge dieselben sind wie im Vorjahr
        </h2>
        <p class="mt-3 text-ink-soft">
          Das ist kein Versehen und keine politische Entscheidung, sondern das
          Ergebnis der Rechenregel. Die Regelbedarfe werden jedes Jahr
          fortgeschrieben; für {jahr} hätte die Fortschreibung
          <strong class="text-ink"> niedrigere</strong> Beträge ergeben. Für
          diesen Fall bestimmt § 28a Abs. 5 SGB XII, dass die bisherigen Werte
          weitergelten — die Beträge dürfen also nicht sinken.
        </p>
        <p class="mt-3 text-ink-soft">
          Wenn Sie Ihren Bescheid mit dem des Vorjahres vergleichen und beim
          Regelbedarf keinen Unterschied finden: Das ist der Grund. Ein Fehler
          steckt dort nicht.
        </p>
        {REGELBEDARF.hinweis && (
          <p class="mt-3 text-[15px] text-ink-mute">{REGELBEDARF.hinweis}</p>
        )}
      </section>
    )
  }

  <section class="mt-14 max-w-prose">
    <h2 class="font-display text-2xl text-ink">
      Regelbedarf, Regelsatz, Grundsicherungsgeld — was heißt was?
    </h2>
    <p class="mt-3 text-ink-soft">
      Drei Wörter für Dinge, die zusammengehören, aber nicht dasselbe sind. Auf
      Ihrem Bescheid steht meist nur eines davon.
    </p>
    <dl class="mt-5 flex flex-col divide-y divide-rule border-y border-rule">
      <div class="py-3">
        <dt class="font-medium text-ink">Regelbedarf</dt>
        <dd class="mt-1 text-[15px] text-ink-soft">
          Der Bedarf selbst: Ernährung, Kleidung, Körperpflege, Hausrat,
          Haushaltsenergie ohne Heizung und Warmwasser, dazu die persönlichen
          Bedürfnisse des täglichen Lebens einschließlich einer Teilhabe am
          sozialen und kulturellen Leben. Er ist in sechs Stufen unterteilt —
          die Tabelle oben.
        </dd>
        <dd class="mt-1 text-[14px] text-ink-mute">§ 20 Abs. 1 SGB II · § 27a Abs. 1 und 2 SGB XII</dd>
      </div>
      <div class="py-3">
        <dt class="font-medium text-ink">Regelsatz</dt>
        <dd class="mt-1 text-[15px] text-ink-soft">
          Der Betrag, mit dem dieser Bedarf in der Sozialhilfe gedeckt wird —
          ein „monatlicher Pauschalbetrag zur Bestreitung des Regelbedarfs", über
          dessen Verwendung Sie selbst entscheiden. Im SGB II heißt derselbe
          Betrag schlicht Regelbedarf; deshalb finden Sie je nach Bescheidart
          das eine oder das andere Wort.
        </dd>
        <dd class="mt-1 text-[14px] text-ink-mute">§ 27a Abs. 3 SGB XII</dd>
      </div>
      <div class="py-3">
        <dt class="font-medium text-ink">Grundsicherungsgeld</dt>
        <dd class="mt-1 text-[15px] text-ink-soft">
          Die Leistung, die erwerbsfähige Leistungsberechtigte erhalten — der
          Regelbedarf ist einer ihrer Bestandteile, nicht ihr Ganzes. Wer den
          Begriff auf seinem Bescheid zum ersten Mal liest: Es ist die Leistung,
          die das Gesetz heute so benennt.
        </dd>
        <dd class="mt-1 text-[14px] text-ink-mute">§ 19 Abs. 1 SGB II</dd>
      </div>
    </dl>
  </section>

  <section class="mt-14 max-w-prose">
    <h2 class="font-display text-2xl text-ink">Quellen</h2>
    <p class="mt-3 text-ink-soft">
      Alle Beträge auf dieser Seite stammen aus dem Volltext der Vorschriften,
      gelesen am {isoToGerman(ERHOBEN_AM)}:
    </p>
    <ul class="mt-3 flex list-disc flex-col gap-1 pl-5">
      {
        QUELLEN.map((q) => (
          <li>
            <a href={q.url} rel="noopener" class="text-ink underline underline-offset-2">
              {q.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Disclaimer />

  <div class="mt-10">
    <AdSlot />
  </div>
</BaseLayout>
