---
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import { SITE_NAME, absoluteUrl } from '../lib/site';
import { adsEnabled, adsenseScriptUrl } from '../lib/ads';

interface Props {
  /** Eindeutig je Seite — zielt auf genau ein Long-Tail-Keyword. */
  title: string;
  /** Eindeutig je Seite, unter 160 Zeichen. */
  description: string;
  /** Pfad mit führendem '/', für canonical und og:url. */
  path: string;
  /** Für Seiten, die erreichbar, aber nicht auffindbar sein sollen. */
  noindex?: boolean;
}

const { title, description, path, noindex } = Astro.props;
const canonical = absoluteUrl(path);
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="de_DE" />
    {/* Nur wenn eine Kennung gesetzt ist — solange sie leer ist, erreicht kein
        Anzeigenskript die Seite, und genau das macht den Satz „setzt keine
        Cookies" in der Datenschutzerklärung nachprüfbar. */}
    {adsEnabled && <script is:inline async src={adsenseScriptUrl()} crossorigin="anonymous"></script>}
  </head>
  <body class="min-h-screen bg-ground font-sans text-ink antialiased">
    <IconSprite />
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-ground"
    >
      Zum Inhalt springen
    </a>

    <header class="border-b border-rule bg-paper">
      <div class="mx-auto max-w-4xl px-4 py-5">
        <a href="/" class="font-display text-lg font-semibold text-ink">{SITE_NAME}</a>
      </div>
    </header>

    {/* Der Satzspiegel gehört ins Layout, nicht in jede Seite — ein vergessener
        Container ist bei erzeugten Seiten nicht ein Einzelfall, sondern die
        ganze Website (Portfolio-Lehre vom 2026-08-15). */}
    <main id="inhalt" class="mx-auto max-w-4xl px-4 py-10">
      <slot />
    </main>

    <footer class="mt-16 border-t border-rule bg-paper">
      <div
        class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-8 text-sm text-ink-mute"
      >
        <a class="underline" href="/">{SITE_NAME}</a>
        <a class="underline" href="/ueber-uns/">Über uns</a>
        <a class="underline" href="/kontakt/">Kontakt</a>
        <a class="underline" href="/impressum/">Impressum</a>
        <a class="underline" href="/datenschutz/">Datenschutz</a>
      </div>
    </footer>
  </body>
</html>
