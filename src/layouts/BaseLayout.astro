---
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import { SITE_NAME, GITHUB_REPO, absoluteUrl } from '../lib/site';
import { adsEnabled, adsenseScriptUrl } from '../lib/ads';

import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';

/**
 * Kurzer Hash des Favicons, an die URL gehängt.
 *
 * Browser halten Favicons in einer eigenen Datenbank, die ein normales
 * Neuladen nicht anfasst — nach einer Änderung sieht man tagelang das alte
 * Symbol und hält den Deploy für kaputt. Genau das ist am 2026-08-17
 * passiert.
 *
 * Der Hash entsteht aus dem Dateiinhalt beim Build, nicht aus einer Zahl, die
 * jemand hochzählt: Eine Version, an die man denken muss, ist dieselbe Art
 * Regel wie der Pre-Deploy-Grep, der es nicht getan hat.
 */
const faviconVersion = createHash('sha256')
  // Gegen das Projektverzeichnis auflösen, nicht relativ zu dieser Datei:
  // `import.meta.url` zeigt beim Build auf den kompilierten Chunk in `dist/`,
  // und der Pfad ginge dann ins Leere.
  .update(readFileSync(join(process.cwd(), 'public/favicon.svg')))
  .digest('hex')
  .slice(0, 8);


interface Props {
  /** Eindeutig je Seite — zielt auf genau ein Long-Tail-Keyword. */
  title: string;
  /** Eindeutig je Seite, unter 160 Zeichen. */
  description: string;
  /**
   * Path starting with '/', used for canonical + og:url.
   *
   * `null` heißt: **diese Seite hat keine eigene Adresse** und bekommt deshalb
   * weder `canonical` noch `og:url`. Das ist keine Feinheit, sondern die Lehre
   * aus der Search-Console-Meldung „Page with redirect" (WNC-20237597) vom
   * 2026-08-23: Die 404-Seite trug `path="/404/"`, während
   * Cloudflare Pages sie aus `dist/404.html` unter `/404` ausliefert. Jede
   * unbekannte URL antwortete also mit einem `canonical` auf `/404/`, Google
   * folgte diesem Hinweis, bekam die 308-Weiterleitung — und meldete eine
   * weitergeleitete Seite. Eine Fehlerseite hat keine kanonische Adresse.
   */
  path: string | null;
  /** Für Seiten, die erreichbar, aber nicht auffindbar sein sollen. */
  noindex?: boolean;
}

const { title, description, path, noindex } = Astro.props;
const canonical = path === null ? null : absoluteUrl(path);
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`/favicon.svg?v=${faviconVersion}`} type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="de_DE" />
    {/* Nur wenn eine Kennung gesetzt ist — solange sie leer ist, erreicht kein
        Anzeigenskript die Seite, und genau das macht den Satz „setzt keine
        Cookies" in der Datenschutzerklärung nachprüfbar. */}
    {adsEnabled && <script is:inline async src={adsenseScriptUrl()} crossorigin="anonymous"></script>}
  </head>
  <body class="min-h-screen bg-ground font-sans text-ink antialiased">
    <IconSprite />
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-ground"
    >
      Zum Inhalt springen
    </a>

    <header class="border-b border-rule bg-paper">
      <div class="mx-auto max-w-4xl px-4 py-5">
        <a href="/" class="font-display text-lg font-semibold text-ink">{SITE_NAME}</a>
      </div>
    </header>

    {/* Der Satzspiegel gehört ins Layout, nicht in jede Seite — ein vergessener
        Container ist bei erzeugten Seiten nicht ein Einzelfall, sondern die
        ganze Website (Portfolio-Lehre vom 2026-08-15). */}
    <main id="inhalt" class="mx-auto max-w-4xl px-4 py-10">
      <slot />
    </main>

    <footer class="mt-16 border-t border-rule bg-paper">
      <div
        class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-8 text-sm text-ink-mute"
      >
        <a class="underline" href="/">{SITE_NAME}</a>
        <a class="underline" href="/ueber-uns/">Über uns</a>
        <a class="underline" href="/kontakt/">Kontakt</a>
        <a class="underline" href="/impressum/">Impressum</a>
        <a class="underline" href="/datenschutz/">Datenschutz</a>
        {/* Das Belegstück zu „nichts wird hochgeladen": im Spiegel steht, dass
            es keinen Endpunkt gibt, an den etwas gehen könnte. Ohne den Link
            ist der Spiegel eine Behauptung über eine Behauptung. */}
        <a class="underline" href={GITHUB_REPO} rel="noopener" target="_blank">Quellcode</a>
      </div>
    </footer>
  </body>
</html>
